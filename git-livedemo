#!/usr/bin/env bash
#
# git-livedemo -- step through a demo one commit at a time.
#
# Playing step N puts step N's tree in the index and working tree while HEAD stays on
# step N-1, so the IDE shows the step as pending changes. A plain checkout would leave
# the Changes view empty.
#
# https://github.com/vspiewak/git-livedemo
#
set -euo pipefail

VERSION=2.0.0
PLAY_BRANCH=${GIT_LIVEDEMO_PLAY_BRANCH:-livedemo}
PLAY_REF="refs/heads/$PLAY_BRANCH"

# Plain when not a terminal, so escapes never land in logs, greps or IDE panes.
if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then CYAN=''; GREY=''; OFF=''
else CYAN=$'\033[36m'; GREY=$'\033[2m'; OFF=$'\033[0m'; fi
if [ -n "${NO_COLOR:-}" ] || [ ! -t 2 ]; then RED=''; OFF_ERR=''
else RED=$'\033[31m'; OFF_ERR=$'\033[0m'; fi

die() { printf '%s%s%s\n' "$RED"  "$*" "$OFF_ERR" >&2; exit 1; }
say() { printf '%s%s%s\n' "$CYAN" "$*" "$OFF"; }
dim() { printf '%s%s%s\n' "$GREY" "$*" "$OFF"; }

usage() {
  cat <<'EOF'
git livedemo -- step through a demo commit by commit

  git livedemo use <branch>    take the steps from a branch you committed yourself
  git livedemo next            play the next step
  git livedemo prev            go back one step
  git livedemo goto <n>        jump to step n (0 = empty working tree)
  git livedemo reset           back to step 0
  git livedemo list            show every step, marking where you are
  git livedemo status          show where you are
  git livedemo exit [branch]   stop playing, back to the branch you came from
  git livedemo version

Each step is an ordinary commit on the branch you point `use` at. Playing step N
leaves HEAD on step N-1 and puts step N in the index and working tree, so your IDE
shows the step as pending changes.

`use` refuses to start on a working tree with uncommitted or untracked files. Once
playing, every move drops whatever is in the tree and starts the step from scratch.
Ignored files (build output, .idea/), nested repositories and submodules are never
touched.

Playback happens on a branch of its own (default: livedemo), created and deleted by
git-livedemo. Set GIT_LIVEDEMO_PLAY_BRANCH to change the name.

State lives in .git/livedemo, so nothing is ever added to your project.
EOF
}

# --------------------------------------------------------------------- command

cmd=${1:-help}
if [ $# -gt 0 ]; then shift; fi

# Answered before the repo is touched: both must work outside a repository.
case "$cmd" in
  version|--version|-v) echo "git-livedemo $VERSION"; exit 0 ;;
  help|--help|-h)       usage; exit 0 ;;
esac

# ---------------------------------------------------------------- repo context

git rev-parse --git-dir >/dev/null 2>&1 || die "Not inside a git repository."
cd "$(git rev-parse --show-toplevel)"   # git clean works from the cwd
STATE="$(git rev-parse --absolute-git-dir)/livedemo"

# Asked for rather than written out: a SHA-256 repository has its own empty tree.
EMPTY_TREE=$(git hash-object -t tree /dev/null)

# ----------------------------------------------------------------------- state

# A config file of our own under .git, read and written by git config: no parsing
# here, and per worktree, unlike --local which linked worktrees share.
state_get()   { [ -f "$STATE" ] && git config -f "$STATE" --get "livedemo.$1" || true; }
state_set()   { git config -f "$STATE" "livedemo.$1" "$2"; }
state_clear() { rm -f "$STATE"; }

BRANCH=$(state_get branch)

branch_exists() { git show-ref --verify --quiet "refs/heads/$1"; }

# Step commits, oldest first; step N is ${STEP[N-1]}. One traversal for all three.
# A read loop rather than mapfile: macOS still ships bash 3.2.
load_steps() {
  STEP=(); TREE=(); SUBJECT=()
  if [ -n "$BRANCH" ] && branch_exists "$BRANCH"; then
    while IFS=' ' read -r sha tree subject; do
      STEP+=("$sha"); TREE+=("$tree"); SUBJECT+=("$subject")
    done < <(git log --reverse --first-parent --format='%H %T %s' "refs/heads/$BRANCH")
  fi
  TOTAL=${#STEP[@]}
}
load_steps

commit_of()  { echo "${STEP[$(($1 - 1))]}"; }
tree_of()    { echo "${TREE[$(($1 - 1))]}"; }
subject_of() { echo "${SUBJECT[$(($1 - 1))]}"; }

# A step number, decimal whatever leading zeros it was typed with: a typed 08 is
# step eight, not a broken octal literal. Fails on anything that is not a number.
to_decimal() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; echo $((10#$1)); }

head_ref() { git symbolic-ref -q HEAD 2>/dev/null || true; }

# Is this commit one of the demo's steps, i.e. ours to delete?
known_commit() {
  local c=$1 i
  for ((i = 0; i < TOTAL; i++)); do [ "$c" = "${STEP[$i]}" ] && return 0; done
  return 1
}

# Playing means: the state names a steps branch and HEAD is on the play branch.
in_session() { [ -n "$BRANCH" ] && [ "$(head_ref)" = "$PLAY_REF" ]; }

require_session() {
  in_session || die "Not playing. Start with: git livedemo use <branch>"
  branch_exists "$BRANCH" ||
    die "The steps branch '$BRANCH' is gone, so there is nothing left to play.
Get out with: git livedemo exit <branch>"
}

current_step() {
  local s
  s=$(to_decimal "$(state_get step)") || s=0
  [ "$s" -le "$TOTAL" ] || s=$TOTAL   # the branch shrank under us
  echo "$s"
}

# A branch name, the commit a detached HEAD sat on, or the bare name when it is
# neither: an origin branch can be unborn, or deleted while the demo was running.
origin_name() {
  local o=${1:-} short
  [ -n "$o" ] || { echo "an unknown branch"; return; }
  branch_exists "$o" && { echo "$o"; return; }
  short=$(git rev-parse -q --short --verify "$o^{commit}" 2>/dev/null || true)
  if [ -n "$short" ]; then echo "detached HEAD ($short)"; else echo "$o"; fi
}

say_step() {
  if [ "$1" -eq 0 ]; then say "Step 0/$TOTAL - empty working tree"
  else say "Step $1/$TOTAL - $(subject_of "$1")"; fi
}

# ----------------------------------------------------------------------- entry

# Everything git would show as a change, untracked files included whatever
# status.showUntrackedFiles says. -z so a non-ASCII or quoted path is printed the
# way it is spelled, not octal-escaped. An untracked .gitignore is left out: it is
# the rules that keep target/ out of this very list, and the answer to it -- stash
# -u -- would un-ignore the build output and make the next attempt worse.
dirty_lines() {
  local rec st path
  while IFS= read -r -d '' rec; do
    st=${rec:0:2}; path=${rec:3}
    case "$st" in [RC]*) IFS= read -r -d '' _ || true ;; esac  # renames carry the old path
    if [ "$st" = '??' ]; then
      case "$path" in .gitignore|*/.gitignore) continue ;; esac
    fi
    printf '  %s %s\n' "$st" "$path"
  done < <(git status --porcelain -z -unormal --ignore-submodules=dirty)
}

# The one gate. Refuses on anything of yours in the working tree, which is what lets
# every step afterwards take the tree back without asking: whatever is there
# mid-demo was put there by the demo.
enter() {
  local branch=$1 head origin dirty shown count subs f
  head=$(head_ref)
  [ "$head" != "$PLAY_REF" ] ||
    die "You are on '$PLAY_BRANCH', the branch playback runs on, but no demo is open
here. If one ended badly, get out with:
  git livedemo exit <branch>
Otherwise switch to another branch, or set GIT_LIVEDEMO_PLAY_BRANCH."

  for f in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD REBASE_HEAD rebase-merge rebase-apply BISECT_LOG; do
    [ ! -e "$(git rev-parse --git-path "$f")" ] ||
      die "A merge, rebase, cherry-pick or bisect is in progress. Finish or abort it first."
  done

  dirty=$(dirty_lines)
  if [ -n "$dirty" ]; then
    count=$(printf '%s\n' "$dirty" | wc -l | tr -d ' ')
    shown=$(printf '%s\n' "$dirty" | head -10)
    [ "$count" -le 10 ] || shown="$shown
  ... and $((count - 10)) more"
    die "The working tree is not clean, and playing would drop all of this:
$shown
Commit it, or stash it with: git stash push -u"
  fi

  # git-livedemo creates the play branch and deletes it on the way out, so one that
  # is already here is a branch of yours or a demo that ended badly. Deleting either
  # is not ours to do: playing would rewind it and `exit` would delete it.
  if branch_exists "$PLAY_BRANCH"; then
    die "Branch '$PLAY_BRANCH' already exists. git-livedemo creates the playback branch
itself and deletes it on the way out, so this one is yours, or a demo that ended
badly. Playing would rewind it.
  git livedemo exit <branch>   leave a demo that is still open
  git branch -D $PLAY_BRANCH   delete it once you have salvaged anything on it
Or set GIT_LIVEDEMO_PLAY_BRANCH to play somewhere else."
  fi
  # A branch checked out in a linked worktree: `git checkout` would refuse to take
  # it, and symbolic-ref would not, so playing would rewind that worktree's HEAD.
  if git worktree list --porcelain | grep -q "^branch $PLAY_REF$"; then
    die "Branch '$PLAY_BRANCH' is checked out in another worktree. Set
GIT_LIVEDEMO_PLAY_BRANCH to play somewhere else."
  fi

  # Remembered so `exit` can put you back where you came from.
  if [ -n "$head" ]; then origin=${head#refs/heads/}
  else origin=$(git rev-parse -q --verify HEAD 2>/dev/null || true); fi
  [ -n "$origin" ] || die "HEAD points nowhere, so there is nothing to come back to."
  state_set origin "$origin"

  subs=$(git ls-files --stage | awk '$1 == "160000" { n++ } END { print n + 0 }')
  [ "$subs" = 0 ] ||
    dim "  Submodules are left exactly as they are; steps do not check them out."

  # Index and working tree stay as they are; play 0 empties them.
  git symbolic-ref HEAD "$PLAY_REF"
}

leave() {
  local origin=$1
  # Live edits go; the ignore rules are on disk, so build output stays.
  LC_ALL=C git clean -fdq
  if branch_exists "$origin"; then
    git checkout -f -q "$origin"
  elif git rev-parse -q --verify "$origin^{commit}" >/dev/null 2>&1; then
    git checkout -f -q --detach "$origin"
  else
    # A branch with no commits yet: an empty tree with HEAD pointing at it.
    git read-tree -u --reset "$EMPTY_TREE"
    git symbolic-ref HEAD "refs/heads/$origin"
  fi
  git branch -D -q "$PLAY_BRANCH" 2>/dev/null || true   # already gone when unborn
}

# ----------------------------------------------------------------------- moves

# Ignore rules stay on disk at every step, whoever committed them. The steps branch
# has the full set, and any file of it missing from the tree is written back,
# untracked. Without this a step from before the commit that added .gitignore leaves
# target/ unprotected, and clean takes it.
ensure_ignore_rules() {
  local p obj
  while IFS= read -r -d '' p; do
    [ -e "$p" ] && continue
    # --with-tree also reports what the index holds, which the branch may not.
    obj=$(git rev-parse -q --verify "refs/heads/$BRANCH:$p" 2>/dev/null || true)
    [ -n "$obj" ] || continue
    mkdir -p "$(dirname "$p")"
    git cat-file blob "$obj" > "$p"
  done < <(git ls-files -z --with-tree="refs/heads/$BRANCH" -- '*.gitignore')
}

play() {
  local n target_tree dropped count
  n=$(to_decimal "${1:-}") || die "Step must be a number, got '${1:-}'"
  [ "$n" -le "$TOTAL" ] || die "There are only $TOTAL steps"

  if [ "$n" -eq 0 ]; then target_tree=$EMPTY_TREE; else target_tree=$(tree_of "$n"); fi

  # HEAD sits on the previous step, so the pending diff is exactly this step. Step 1
  # has none, so HEAD goes unborn and the whole tree reads as added.
  if [ "$n" -le 1 ]; then
    git update-ref -d HEAD 2>/dev/null || true
  else
    git update-ref HEAD "$(commit_of $((n - 1)))"
  fi

  # The step's tree and nothing else, in this order: --reset rewrites tracked files
  # and drops the ones this step does not have, the ignore rules go back before
  # clean reads them, then clean takes what was typed live. One -f, not two: a
  # nested repository is a submodule as often as it is a prop, and deleting one
  # costs a re-clone. -e spares the ignore rules themselves.
  git read-tree -u --reset "$target_tree"
  ensure_ignore_rules
  dropped=$(LC_ALL=C git clean -fd -e .gitignore | sed 's/^Removing /  dropped /')

  state_set step "$n"
  say_step "$n"
  [ "$n" -eq 0 ] || dim "  $(git diff --cached --shortstat | sed 's/^ *//')"
  if [ -n "$dropped" ]; then
    count=$(printf '%s\n' "$dropped" | wc -l | tr -d ' ')
    printf '%s\n' "$dropped" | head -5 | while IFS= read -r line; do dim "$line"; done
    [ "$count" -le 5 ] || dim "  ... and $((count - 5)) more"
  fi
}

# -------------------------------------------------------------------- dispatch

case "$cmd" in
  use)
    branch=${1:-}
    [ -n "$branch" ] || die "usage: git livedemo use <branch>"
    # Answered before existence: naming the play branch is a mistake worth its own
    # message whether or not that branch happens to be there yet.
    [ "$branch" != "$PLAY_BRANCH" ] ||
      die "'$branch' is the branch playback runs on. Pick another, or set
GIT_LIVEDEMO_PLAY_BRANCH to move playback out of the way."
    # A local branch, verified: rev-parse would take a tag or a sha just as happily.
    branch_exists "$branch" ||
      die "No such branch: $branch
Steps come from a local branch you committed yourself; 'git branch' lists them."
    in_session || enter "$branch"
    state_set branch "$branch"
    BRANCH=$branch; load_steps
    [ "$TOTAL" -gt 0 ] || die "'$branch' has no commits, so there are no steps."
    plural=s; [ "$TOTAL" -eq 1 ] && plural=""
    say "Playing '$branch' ($TOTAL step$plural). You were on $(origin_name "$(state_get origin)"); 'git livedemo exit' takes you back."
    play 0
    ;;
  next)
    require_session; n=$(current_step)
    [ "$n" -lt "$TOTAL" ] || die "Already at the last step ($TOTAL)"
    play $((n + 1))
    ;;
  prev)
    require_session; n=$(current_step)
    [ "$n" -gt 0 ] || die "Already at step 0"
    play $((n - 1))
    ;;
  goto)
    require_session
    [ -n "${1:-}" ] || die "usage: git livedemo goto <n>"
    play "$1"
    ;;
  reset) require_session; play 0 ;;
  status)
    require_session
    say_step "$(current_step)"
    dim "  playing '$BRANCH', you were on $(origin_name "$(state_get origin)")"
    ;;
  list)
    require_session; n=$(current_step)
    for ((i = 0; i <= TOTAL; i++)); do
      if [ "$i" -eq "$n" ]; then printf '%s->%s ' "$CYAN" "$OFF"; else printf '   '; fi
      if [ "$i" -eq 0 ]; then printf '%2d  (empty working tree)\n' 0
      else printf '%2d  %s\n' "$i" "$(subject_of "$i")"; fi
    done
    ;;
  exit|stop)
    origin=$(state_get origin)
    [ -n "$origin" ] || origin=${1:-}
    if [ "$(head_ref)" = "$PLAY_REF" ]; then
      # The state can be gone -- a stray rm, a tool that cleaned .git -- and HEAD is
      # then stranded on a branch a plain checkout refuses to leave. Being told where
      # to go is enough to get out.
      [ -n "$origin" ] ||
        die "Nothing is recorded about where this demo started, so say where to go:
  git livedemo exit <branch>"
      leave "$origin"
      state_clear
      say "Back on $(origin_name "$origin")."
    else
      # HEAD left on its own, so there is nothing to check out, only to tidy up.
      [ -n "$origin$BRANCH" ] || die "Not playing."
      if branch_exists "$PLAY_BRANCH" &&
         known_commit "$(git rev-parse -q --verify "$PLAY_REF")"; then
        git branch -D -q "$PLAY_BRANCH"
        dim "  deleted the leftover '$PLAY_BRANCH' branch"
      elif branch_exists "$PLAY_BRANCH"; then
        dim "  left '$PLAY_BRANCH' alone: its tip is not one of the steps"
      fi
      state_clear
      say "HEAD had already left '$PLAY_BRANCH'; cleared the demo state. You are on $(origin_name "$(git symbolic-ref -q --short HEAD || git rev-parse HEAD)")."
    fi
    ;;
  *) die "Unknown command '$cmd'. Try: git livedemo help" ;;
esac
